<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>icons\SchemaCompare.ico</ApplicationIcon>
    <BuildVersion Condition="'$(BuildVersion)' == ''">dev</BuildVersion>
    <!-- Generate the build stamp without changing the existing assembly identity. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildVersion</_Parameter1>
      <_Parameter2>$(BuildVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="ValidateBuildVersion" BeforeTargets="CoreGenerateAssemblyInfo">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(BuildVersion)', '^(dev|[0-9]{8}(\.[1-9][0-9]*)?)$'))"
           Text="BuildVersion must be dev or YYYYMMDD with an optional positive numeric suffix (for example 20261029.1)." />
  </Target>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'x64|AnyCPU'">
    <OutputPath>bin\x64\</OutputPath>
    <Optimize>true</Optimize>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'x64|x64'">
    <OutputPath>bin\x64\x64\</OutputPath>
    <Optimize>true</Optimize>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Functional\**" />
    <Compile Remove="Models\**" />
    <Compile Remove="Validation\**" />
    <EmbeddedResource Remove="Functional\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Validation\**" />
    <None Remove="Functional\**" />
    <None Remove="Models\**" />
    <None Remove="Validation\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="Microsoft.Azure.Kusto.Data" Version="14.2.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.ComponentModel.Composition" Version="9.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="SchemaPickerControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="icons\LibrarySetting_16x.png" />
    <EmbeddedResource Include="icons\SchemaCompare.ico" />
    <Content Include="icons\SyncArrow_16x.png" />
    <Content Include="icons\UploadFile_16x.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SyncKusto.Core\SyncKusto.Core.csproj" />
    <ProjectReference Include="..\SyncKusto.Kusto\SyncKusto.Kusto.csproj" />
    <ProjectReference Include="..\SyncKusto.FileSystem\SyncKusto.FileSystem.csproj" />
  </ItemGroup>
</Project>